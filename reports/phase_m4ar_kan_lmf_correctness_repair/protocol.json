{
  "phase": "M4AR",
  "fixed_cohort": {
    "n_patients": 512,
    "dss_events": 65
  },
  "fixed_split": "outputs/phase_m1r/fixed_patient_folds.csv; same five outer folds",
  "preprocessing": "M2R2/M3 fold-local preprocessing unchanged",
  "endpoint": "DSS",
  "cox": "negative Breslow Cox partial likelihood with T_j >= T_i",
  "pathology": {
    "encoder": "UNI2-h",
    "K": 1024
  },
  "seeds": [
    20260916,
    20260917,
    20260918
  ],
  "variants": {
    "A0": "MCAT-OriginalFusion",
    "A1": "MCAT-MatchedMLP",
    "A2": "MCAT-KAN-PM-fixed",
    "A2W": "MCAT-KAN-WM-fixed",
    "A3": "MCAT-ReferenceLMF",
    "B0": "CommonOnly-OriginalFusion",
    "B1": "CommonOnly-MatchedMLP",
    "B2": "CommonOnly-KAN-PM-fixed",
    "B2W": "CommonOnly-KAN-WM-fixed",
    "B3": "CommonOnly-ReferenceLMF",
    "C0": "ClinicalOnly"
  },
  "kan": {
    "implementation": "CompactSplineKAN",
    "pm_hidden": 8,
    "wm_hidden": 48,
    "grid_size": 5,
    "spline_order": 3,
    "range": [
      -3.0,
      3.0
    ],
    "dynamic_grid": false,
    "boundary_rule": "only last basis is 1 at x=max"
  },
  "lmf": {
    "implementation": "ReferenceLMF",
    "rank": 8,
    "output_dim": 32,
    "factor_initialization": "xavier_normal_",
    "fusion_weight_initialization": "xavier_normal_",
    "bias": "zero",
    "post_fusion": "GELU then RiskHead; no LayerNorm"
  },
  "fairness": {
    "representation_and_projector_shared": true,
    "risk_head_shared_where_shapes_match": true,
    "variant_only_isolated_seed": true,
    "forbidden": [
      "resplit",
      "seed hunting",
      "preprocessing change",
      "Cox change",
      "endpoint change",
      "test-fold tuning",
      "optimizer tuning"
    ]
  },
  "evaluation": {
    "primary": "fold-level Harrell C",
    "secondary": "fold-level Uno C",
    "aggregation": "mean/std over 15 seed×fold cells",
    "global_oof": "diagnostic only"
  },
  "training": {
    "max_epochs": 25,
    "patience": 5,
    "batch_size": 16,
    "optimizer": "AdamW lr=3e-4 weight_decay=1e-4",
    "outer_refit": "same seed, full outer train, selected inner epoch count"
  }
}
